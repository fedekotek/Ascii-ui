{
  "global": {
    "grid": {
      "$description": "Everything on screen snaps to one cell: one character wide, one row tall. No free pixel sizes.",
      "cell": {
        "$type": "string",
        "$value": "1ch",
        "$description": "One character of the type, wide. Every width is a whole number of these (CSS ch)."
      },
      "row": {
        "$type": "dimension",
        "$value": "21px",
        "$description": "One row (--r). Every height is a whole number of rows."
      }
    },
    "type": {
      "family": {
        "$type": "fontFamily",
        "$value": "Geist Mono",
        "$description": "Monospace, self-hosted, the only face. The grid needs every character the same width."
      },
      "size": {
        "$type": "dimension",
        "$value": "14px",
        "$description": "Body type, at every width."
      },
      "lineHeight": {
        "$type": "dimension",
        "$value": "21px",
        "$description": "One row."
      },
      "weight": {
        "$type": "fontWeight",
        "$value": 300,
        "$description": "Body. Gray text is 400, frames, slabs and titles are 700."
      }
    },
    "ramp": {
      "$description": "Nine steps, space to @, lightest to heaviest. Weight comes from how dense a character is: every frame, fill and chart is an index into these.",
      "all": {
        "$type": "string",
        "$value": " .:=+*#%@",
        "$description": "The whole ramp, index 0 to 8. Swap the characters and you have a different kit."
      },
      "k0": {
        "$type": "string",
        "$value": " ",
        "$description": "0. Nothing. Air."
      },
      "k1": {
        "$type": "string",
        "$value": ".",
        "$description": "1. The faintest mark: an empty track, a dotted fill."
      },
      "k2": {
        "$type": "string",
        "$value": ":",
        "$description": "2. Shade: rules, and the sides of light frames."
      },
      "k3": {
        "$type": "string",
        "$value": "=",
        "$description": "3. Light: the top and bottom of light frames."
      },
      "k4": {
        "$type": "string",
        "$value": "+",
        "$description": "4. Low fill in bars and charts."
      },
      "k5": {
        "$type": "string",
        "$value": "*",
        "$description": "5. Middle fill in bars and charts."
      },
      "k6": {
        "$type": "string",
        "$value": "#",
        "$description": "6. Mid frames."
      },
      "k7": {
        "$type": "string",
        "$value": "%",
        "$description": "7. Dense frames."
      },
      "k8": {
        "$type": "string",
        "$value": "@",
        "$description": "8. Heavy: primary buttons, cards, the focus rim, a full bar."
      }
    },
    "tone": {
      "$description": "Frame tones. A frame is a string of characters: rule runs along the top and bottom, side is one wall, a row at a time.",
      "heavy": {
        "$description": "Heavy. Primary buttons, cards and the focus rim.",
        "rule": {
          "$type": "string",
          "$value": "@"
        },
        "side": {
          "$type": "string",
          "$value": "@@"
        }
      },
      "dense": {
        "$description": "Dense. One step under heavy.",
        "rule": {
          "$type": "string",
          "$value": "%"
        },
        "side": {
          "$type": "string",
          "$value": "%%"
        }
      },
      "mid": {
        "$description": "Mid. A plain frame.",
        "rule": {
          "$type": "string",
          "$value": "#"
        },
        "side": {
          "$type": "string",
          "$value": "##"
        }
      },
      "light": {
        "$description": "Light. Secondary buttons and quiet frames.",
        "rule": {
          "$type": "string",
          "$value": "="
        },
        "side": {
          "$type": "string",
          "$value": "::"
        }
      },
      "shade": {
        "$description": "Shade. Rules and walls that stay out of the way.",
        "rule": {
          "$type": "string",
          "$value": ":"
        },
        "side": {
          "$type": "string",
          "$value": "::"
        }
      },
      "faint": {
        "$description": "Faint. Dashed: empty, a placeholder, a drop zone.",
        "rule": {
          "$type": "string",
          "$value": "- "
        },
        "side": {
          "$type": "string",
          "$value": ": "
        }
      },
      "danger": {
        "$description": "Danger. Destructive actions.",
        "rule": {
          "$type": "string",
          "$value": "/"
        },
        "side": {
          "$type": "string",
          "$value": "//"
        }
      },
      "error": {
        "$description": "Error. A wrong field, a failed toast.",
        "rule": {
          "$type": "string",
          "$value": "!"
        },
        "side": {
          "$type": "string",
          "$value": "!!"
        }
      }
    },
    "motion": {
      "$description": "The kit's motion. Steps, never eased: a step is a whole character or a whole row. Reduced motion turns all of it off.",
      "duration": {
        "quick": {
          "$type": "duration",
          "$value": "160ms",
          "$description": "--aui-quick. A switch flips, a tooltip types in, a panel wipes open."
        },
        "base": {
          "$type": "duration",
          "$value": "240ms",
          "$description": "--aui-base. A toast types in, an alert dialog nudges."
        },
        "slow": {
          "$type": "duration",
          "$value": "280ms",
          "$description": "--aui-slow. A sheet comes up."
        },
        "toast": {
          "$type": "duration",
          "$value": "3600ms",
          "$description": "--aui-toast. The shortest a toast stays. Longer words stay longer."
        }
      },
      "easing": {
        "flip": {
          "$type": "string",
          "$value": "steps(2)",
          "$description": "--aui-ease-flip. The switch thumb, one character a step."
        },
        "type": {
          "$type": "string",
          "$value": "steps(12)",
          "$description": "--aui-ease-type. The tooltip and the toast, typed in from the left."
        },
        "wipe": {
          "$type": "string",
          "$value": "steps(4)",
          "$description": "--aui-ease-wipe. A panel, a row a step."
        },
        "rise": {
          "$type": "string",
          "$value": "steps(7)",
          "$description": "--aui-ease-rise. The sheet, from the bottom."
        },
        "jolt": {
          "$type": "string",
          "$value": "steps(1,end)",
          "$description": "--aui-ease-jolt. The nudge, no in-betweens."
        }
      }
    }
  },
  "light": {
    "color": {
      "$description": "Light mode: Paper.",
      "bg": {
        "$type": "color",
        "$value": "#ecebe4",
        "$description": "Surface. The page."
      },
      "ink": {
        "$type": "color",
