        "$description": "Text, frames and primary slabs."
      },
      "muted": {
        "$type": "color",
        "$value": "#5c5b55",
        "$description": "Secondary text."
      },
      "hot": {
        "$type": "color",
        "$value": "#c91468",
        "$description": "Magenta. It acts: primary buttons, title bars. Also the worst state (Down), which always carries a word."
      },
      "pink": {
        "$type": "color",
        "$value": "#e8478f",
        "$description": "Secondary emphasis and halftone tails. Marks only, never body text."
      },
      "cy": {
        "$type": "color",
        "$value": "#0a7287",
