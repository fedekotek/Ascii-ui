        "$description": "Poster titles, row 1, the top."
      },
      "t1": {
        "$type": "color",
        "$value": "#111110",
        "$description": "Poster titles, row 2."
      },
      "t2": {
        "$type": "color",
        "$value": "#c91468",
        "$description": "Poster titles, row 3."
      },
      "t3": {
        "$type": "color",
        "$value": "#2b2bd1",
        "$description": "Poster titles, row 4, the bottom."
      }
    }
  },
